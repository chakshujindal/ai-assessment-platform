# Copy to backend/.env and fill in. Every value here is optional; defaults run the demo.

# fake (no key, deterministic), anthropic, or openai
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=your-anthropic-key-here
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=your-openai-key-here
OPENAI_MODEL=gpt-6.1-sol

# SQLite by default; e.g. postgresql+psycopg://user:pass@localhost:5432/assessments
DATABASE_URL=sqlite:///./data/app.db

# At least 32 characters. Leave unset in dev for a random per-process secret.
# JWT_SECRET=replace-with-a-long-random-string

# Public origin candidates use; needed for Safe Exam Browser checks behind a proxy.
PUBLIC_BASE_URL=
CORS_ORIGINS=http://localhost:5173
